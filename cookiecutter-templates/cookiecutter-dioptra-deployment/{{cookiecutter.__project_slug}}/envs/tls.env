# Derived from config/ssl.toml and effective Compose mappings by manage_ssl.py.
DIOPTRA_TLS_ALLOWED_AUTHORITIES='["{{ cookiecutter.__project_slug }}-restapi:5000","{{ cookiecutter.nginx_server_name }}:{{ cookiecutter.__restapi_https_port }}"]'
DIOPTRA_TLS_KEY_EXCHANGE=default
DIOPTRA_PUBLIC_HOST={{ cookiecutter.nginx_server_name }}
DIOPTRA_PUBLIC_HTTPS_PORT={{ cookiecutter.__restapi_https_port }}
