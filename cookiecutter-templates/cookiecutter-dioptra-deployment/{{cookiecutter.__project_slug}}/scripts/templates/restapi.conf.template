upstream container-restapi {
    server {{ cookiecutter.__project_slug }}-restapi:5000;
}

server {
    listen 30080 default_server;
    server_name _;
    return 400;
}

server {
    listen 30080;
    server_name __DIOPTRA_PUBLIC_HOST__;
    return 308 https://__DIOPTRA_PUBLIC_AUTHORITY__$request_uri;
}

server {
    listen 30443 ssl default_server;
    server_name _;
    __DIOPTRA_LISTENER_GROUPS__
    return 400;
}

server {
    listen 30443 ssl;
    server_name __DIOPTRA_PUBLIC_HOST__;
    __DIOPTRA_LISTENER_GROUPS__
    proxy_redirect off;
    proxy_ssl_protocols TLSv1.3;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_server_name on;
    proxy_ssl_name {{ cookiecutter.__project_slug }}-restapi;
    __DIOPTRA_UPSTREAM_GROUPS__

    # The API derives HTTPS from its own TLS connection and permits only configured
    # Host values. Remove client-supplied proxy identity claims before forwarding;
    # they must not select a different scheme, host or path prefix in the API.
    # All API locations inherit this set. A location adding proxy_set_header must
    # repeat the complete set because nginx replaces header inheritance.
    proxy_set_header Host __DIOPTRA_PUBLIC_AUTHORITY__;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Forwarded-Protocol "";
    proxy_set_header X-Forwarded-Ssl "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-Prefix "";

    location / {
        root /frontend;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass https://container-restapi/api/;
    }

    location /api-docs/ {
        proxy_pass https://container-restapi/;
    }

    location /swagger.json {
        proxy_pass https://container-restapi/swagger.json;
    }

    location /swaggerui/ {
        proxy_pass https://container-restapi/swaggerui/;
    }

    location = /health {
        proxy_pass https://container-restapi/health;
    }

    location = /health/ {
        proxy_pass https://container-restapi/health;
    }
}
